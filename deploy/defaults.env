# Dev-safe container defaults for Docker Compose (loaded BEFORE the repo-root `.env`, which
# overrides every line here). No real secret belongs in this file — it is committed.
# Keys mirror .env.example; keep the two files in sync when a variable is added.
CTCV_ENV=dev
LOG_LEVEL=INFO
APP_DOMAIN=localhost
STATUS_DOMAIN=localhost

POSTGRES_USER=ctcv
POSTGRES_PASSWORD=ctcv-dev-only
POSTGRES_DB=ctcv
# E01 skeleton: ctcv-api ships no PostgreSQL driver yet (D15 — Postgres from E02), so the
# container runs on SQLite inside the api_data volume. E02: switch to
# DATABASE_URL=postgresql+psycopg://ctcv:<POSTGRES_PASSWORD>@postgres:5432/ctcv
DATABASE_URL=sqlite+pysqlite:////var/lib/ctcv/api.db
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ctcv-dev
MINIO_SECRET_KEY=ctcv-dev-secret
MINIO_BUCKET_SCREENS=screens

JWT_SECRET=dev-only-not-a-secret-change-in-dot-env
JWT_TTL_MINUTES=120

# cpu profile: point this at the rented GPU box (SSH tunnel/Tailscale) or a llama.cpp server;
# gpu profile: the in-stack vLLM; llama profile: http://models-cpu:8040/v1
VLLM_BASE_URL=http://models:8040/v1
PLANNER_MODEL=Qwen/Qwen3.5-9B
VLM_MODEL=Qwen/Qwen3.5-9B

ASR_MODEL=vinai/PhoWhisper-small
TTS_CACHE_DIR=/var/cache/ctcv/tts
HF_HOME=/var/cache/ctcv/hf

SCREEN_TTL_SECONDS=60
LOG_RETENTION_DAYS=30
RATE_LIMIT_PER_MIN=60
MAX_CONCURRENT_SESSIONS=200
