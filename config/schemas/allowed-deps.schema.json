{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctcv.local/schemas/allowed-deps.schema.json",
  "title": "CTCV dependency allow-list (config/allowed-deps.yaml, brief D26)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "banned_packages", "banned_license_patterns", "python", "node"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "banned_packages": {
      "description": "Never allowed in any ecosystem (AGPL detectors etc.).",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "banned_license_patterns": {
      "description": "Python regexes; a runtime entry whose license matches any of them fails `make audit`.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "python": { "$ref": "#/$defs/entries" },
    "node": { "$ref": "#/$defs/entries" }
  },
  "$defs": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "license", "runtime", "reason", "epic"],
        "properties": {
          "name": {
            "description": "Package name as published (PyPI/npm); matching is case-insensitive and treats -, _ and . alike.",
            "type": "string",
            "minLength": 1
          },
          "license": {
            "description": "SPDX expression or the classifier text as published.",
            "type": "string",
            "minLength": 2
          },
          "runtime": {
            "description": "True when shipped in a service image; false for dev/test/build tooling.",
            "type": "boolean"
          },
          "reason": { "type": "string", "minLength": 3 },
          "epic": { "type": "string", "pattern": "^(E[0-9]{2}|PILOT|DOSSIER)$" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
