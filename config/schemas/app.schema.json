{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctcv.local/schemas/app.schema.json",
  "title": "CTCV application config (config/app.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "env",
    "ports",
    "screen_ttl_seconds",
    "log_retention_days",
    "rate_limit_per_min",
    "max_concurrent_sessions",
    "jwt_ttl_minutes",
    "ui",
    "roles",
    "skill_groups"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "env": { "type": "string", "enum": ["dev", "test", "staging", "prod"] },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "agent",
        "speech",
        "vision",
        "models",
        "web",
        "caddy_http",
        "caddy_https",
        "postgres",
        "redis",
        "qdrant",
        "minio",
        "minio_console",
        "uptime_kuma",
        "prometheus",
        "grafana"
      ],
      "patternProperties": {
        "^[a-z_]+$": { "$ref": "#/$defs/port" }
      }
    },
    "screen_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "log_retention_days": { "type": "integer", "minimum": 1, "maximum": 365 },
    "rate_limit_per_min": { "type": "integer", "minimum": 1 },
    "max_concurrent_sessions": { "type": "integer", "minimum": 1 },
    "jwt_ttl_minutes": { "type": "integer", "minimum": 5, "maximum": 1440 },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_font_pt", "min_tap_px", "viewports"],
      "properties": {
        "min_font_pt": { "type": "integer", "minimum": 20 },
        "min_tap_px": { "type": "integer", "minimum": 48 },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]{3,4}x[0-9]{3,4}$" }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/role" }
    },
    "skill_groups": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/skill_group" }
    }
  },
  "$defs": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "role": { "type": "string", "enum": ["citizen", "volunteer", "officer"] },
    "skill_group": {
      "type": "string",
      "enum": [
        "thiet-bi-co-ban",
        "dinh-danh-vneid",
        "dich-vu-cong",
        "thanh-toan-thue-so",
        "an-toan-so"
      ]
    }
  }
}
