# Flags for the `models` (vLLM, profile gpu) and `models-cpu` (llama.cpp, profile llama)
# services — read by deploy/docker-compose.yml. Copy to deploy/models/vllm.env (gitignored)
# on the GPU box; every key has the same default inside the compose file. Explanations and
# VRAM budgeting: deploy/models/README.md. Model changes are a mandatory stop point (ADR-002).

# ---- vLLM (one served model, D9 v2) --------------------------------------------------------
# Checkpoint to load. Use the AWQ 4-bit checkpoint produced by `make train` (E07 quantisation
# step) or an Apache-2.0 AWQ export of Qwen/Qwen3.5-9B; with the bf16 base set
# VLLM_QUANTIZATION= (empty) and VLLM_DTYPE=bfloat16 and lower VLLM_MAX_NUM_SEQS.
VLLM_MODEL=Qwen/Qwen3.5-9B
# Name clients pass as `model` (config/models.yaml: planner.id / vlm.id / quarantine.id).
VLLM_SERVED_NAME=Qwen/Qwen3.5-9B
VLLM_QUANTIZATION=awq
VLLM_DTYPE=half
# Context window: prompt (coach.v1 + sandbox state + tool results) + ≤ 160 output tokens.
VLLM_MAX_MODEL_LEN=4096
# Share of the 24 GB card vLLM may reserve for weights + KV cache (alert fires at 92 %).
VLLM_GPU_MEMORY_UTILIZATION=0.90
# Concurrent sequences: 50 active pilot users with think-time ≈ 8–12 in flight.
VLLM_MAX_NUM_SEQS=32
# Screen reading (vlm): one image per prompt; the same server answers text-only calls.
VLLM_LIMIT_MM_PER_PROMPT=image=1
# Extra flags appended verbatim. Multi-LoRA after E07 ships the coach adapter:
#   --enable-lora --max-lora-rank 16 --lora-modules coach=/models/adapters/coach
VLLM_EXTRA_ARGS=
# Number of GPUs reserved by compose (deploy.resources.reservations.devices).
VLLM_GPU_COUNT=1
# Only for gated Hugging Face repos (Qwen3.5 is public) — never commit a real token.
HF_TOKEN=

# ---- llama.cpp (profile llama — official CPU path, D29) ----------------------------------
# GGUF file inside deploy/models/cache/ (gitignored); Q4_K_M of config/models.yaml planner_small.
LLAMA_MODEL_FILE=qwen3.5-2b-q4_k_m.gguf
LLAMA_SERVED_NAME=Qwen/Qwen3.5-2B
LLAMA_CTX=4096
LLAMA_THREADS=4
LLAMA_PARALLEL=2
