# ============================================================================
# CTCV — biến môi trường mẫu. Sao chép thành `.env` và điền giá trị thật.
# KHÔNG commit `.env`. Giá trị thật chỉ nằm trong `.env` (máy dev) và GitHub Secrets (CI).
# Cổng mặc định khớp config/app.yaml (brief §2). Tham chiếu: docs/plan.md §15.
# ============================================================================

# ---- Docker Compose -------------------------------------------------------
COMPOSE_PROJECT_NAME=ctcv
# Profile `cpu` (máy dev Windows, CI: llama.cpp + Qwen3.5-2B GGUF) hoặc `gpu` (máy thuê: vLLM) — D29
COMPOSE_PROFILES=cpu
CTCV_ENV=dev
LOG_LEVEL=INFO

# ---- Cổng dịch vụ (khớp config/app.yaml: ports) --------------------------
API_PORT=8000
AGENT_PORT=8010
SPEECH_PORT=8020
VISION_PORT=8030
MODELS_PORT=8040
WEB_PORT=5173
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
UPTIME_KUMA_PORT=3001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- Domain ---------------------------------------------------------------
APP_DOMAIN=localhost
STATUS_DOMAIN=localhost

# ---- Kết nối dữ liệu ------------------------------------------------------
POSTGRES_USER=ctcv
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ctcv
DATABASE_URL=postgresql+psycopg://ctcv:CHANGE_ME@postgres:5432/ctcv
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_SCREENS=screens

# ---- Xác thực -------------------------------------------------------------
JWT_SECRET=CHANGE_ME
JWT_TTL_MINUTES=120

# ---- Phục vụ model (vLLM, OpenAI-compatible) ------------------------------
VLLM_BASE_URL=http://models:8040/v1
PLANNER_MODEL=Qwen/Qwen3.5-9B
# Đề xuất ADR-002 (chờ chốt): cùng model Qwen3.5-9B đọc ảnh; phương án B: Qwen/Qwen3-VL-8B-Instruct
VLM_MODEL=Qwen/Qwen3.5-9B

# ---- Giọng nói ------------------------------------------------------------
ASR_MODEL=vinai/PhoWhisper-small
TTS_MODEL=CHANGE_ME_ADR-002
TTS_CACHE_DIR=/var/cache/ctcv/tts

# ---- Tải model ------------------------------------------------------------
HF_TOKEN=CHANGE_ME

# ---- Máy GPU thuê (make doctor GPU=1 kiểm tra qua SSH; VLLM_BASE_URL trỏ qua tunnel) ----
GPU_SSH_HOST=CHANGE_ME

# ---- Chỉ cho bước sinh dữ liệu tổng hợp (E06) — không dùng ở runtime ------
SYNTH_LLM_PROVIDER=none
SYNTH_LLM_API_KEY=CHANGE_ME
SYNTH_BUDGET_VND=500000

# ---- Chính sách dữ liệu ---------------------------------------------------
SCREEN_TTL_SECONDS=60
LOG_RETENTION_DAYS=30

# ---- Bảo vệ tải -----------------------------------------------------------
RATE_LIMIT_PER_MIN=60
MAX_CONCURRENT_SESSIONS=200

# ---- Cảnh báo -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# RAG thủ tục hành chính (ADR-007)
CTCV_OLLAMA_BASE_URL=http://localhost:11434
# CTCV_RAG_COMPOSE_MODE=template_only  # dự phòng khi CPU quá chậm
# Chế độ demo: để trống = TẮT; API từ chối khởi động ở prod nếu đặt
# Mã QR lớp học, tối thiểu 16 ký tự
CTCV_DEMO_QR_TOKEN=
# Mật khẩu cán bộ demo, tối thiểu 12 ký tự
CTCV_DEMO_STAFF_PASSWORD=
